{
  "AllowedHosts": "localhost;hospital.test",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": { "SqlServer": "" },
  "Jwt": {
    "Issuer": "Sistema.Gestao.Empresarial",
    "Audience": "Sistema.Gestao.Empresarial.Web",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 10
  },
  "Session": {
    "InactivityTimeoutMinutes": 30,
    "ActivityPersistenceIntervalSeconds": 60,
    "EnableSqlFallback": true,
    "AbsoluteLifetimeDays": 7,
    "MaximumFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "Redis": { "Configuration": "", "InstanceName": "sge", "ConnectTimeoutSeconds": 5 },
  "Cache": { "PermissionTtlSeconds": 120 },
  "RabbitMq": { "Host": "", "Port": 5672, "VirtualHost": "/", "Username": "", "Password": "" },
  "Outbox": { "BatchSize": 50, "PollingIntervalSeconds": 5, "LeaseSeconds": 60, "MaximumRetryDelaySeconds": 300 },
  "Inbox": {
    "TransientRetryCount": 5,
    "InitialRetryDelaySeconds": 2,
    "MaximumRetryDelaySeconds": 60,
    "ConcurrentMessageLimit": 16,
    "QueueName": "sge-integration-events-v1",
    "ConsumerName": "IntegrationEventConsumer"
  },
  "Audit": { "PersistenceTimeoutSeconds": 2, "ChannelCapacity": 5000 },
  "AuditRetention": {
    "Enabled": true,
    "HttpAccessLogDays": 180,
    "BusinessAuditDays": 1825,
    "BatchSize": 500,
    "SweepIntervalHours": 24,
    "MaximumBatchesPerSweep": 20
  },
  "ReverseProxy": { "Enabled": false, "ForwardLimit": 1, "KnownProxies": [] },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60,
    "AuthenticationPermitLimit": 5,
    "AuthenticationWindowSeconds": 60
  },
  "KestrelSecurity": {
    "MaxRequestBodySizeBytes": 1048576,
    "RequestHeadersTimeoutSeconds": 10,
    "KeepAliveTimeoutSeconds": 30,
    "MinRequestBodyDataRateBytesPerSecond": 240,
    "MinRequestBodyDataRateGracePeriodSeconds": 5
  },
  "OpenTelemetry": { "Enabled": true, "OtlpEndpoint": "http://localhost:4317", "SamplingRatio": 0.1 },
  "Swagger": { "Enabled": false }
}
